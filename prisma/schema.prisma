  targetType     String    @default("document")
  targetKey      String    @default("")
  parentId       String?
  body           String
  visibility     String    @default("shared")
  kind           String    @default("comment")
  status         String    @default("open")
  classification String?
  mentions       String    @default("[]")
  attachmentIds  String    @default("[]")
  authorId       String?
  authorName     String
  authorKind     String
  resolvedByName String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  document SrsDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, targetType, targetKey])
  @@index([documentId, kind, status])
}

/// Immutable snapshot of the document. Approved snapshots are the signed baseline.
model SrsVersion {
  id              String    @id @default(cuid())
  documentId      String
  seq             Int
  label           String
  kind            String
  status          String
  snapshot        String
  hash            String
  note            String    @default("")
  clientVisible   Boolean   @default(false)
  publishedAt     DateTime?
  changeRequestId String?
  createdById     String?
  createdByName   String
  approvedAt      DateTime?
  supersededAt    DateTime?
  createdAt       DateTime  @default(now())

  document   SrsDocument    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  signatures SrsSignature[]
  artifacts  SrsArtifact[]

  @@unique([documentId, seq])
  @@index([documentId, status])
}

model SrsSignature {
  id            String   @id @default(cuid())
  documentId    String
  versionId     String
  side          String
  signerId      String
  signerName    String
  signerEmail   String
  signerRole    String
  decision      String
  statement     String
  method        String
  typedName     String
  drawing       String?
  comment       String   @default("")
  snapshotHash  String
  signatureHash String
  ipAddress     String   @default("")
  userAgent     String   @default("")
  createdAt     DateTime @default(now())

  document SrsDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version  SrsVersion  @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, signerId])
}

model SrsArtifact {
  id            String   @id @default(cuid())
  documentId    String
  versionId     String
  format        String
  fileName      String
  storageKey    String
  sha256        String
  byteSize      Int
  createdByName String
  createdAt     DateTime @default(now())

  document SrsDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version  SrsVersion  @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, format])
}

model SrsLink {
  id            String   @id @default(cuid())
  itemId        String
  targetType    String
  targetId      String
  label         String   @default("")
  createdByName String
  createdAt     DateTime @default(now())

  item SrsItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, targetType, targetId])
  @@index([targetType, targetId])
}