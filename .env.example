# Supabase → Connect → Session pooler (port 5432). The transaction pooler (port 6543) makes
# Prisma wrap every query in its own transaction, which costs four round trips instead of one.
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?connection_limit=10"
# Migrations use the same session pooler.
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Tests wipe every table in this schema. Same session-pooler URL, with a dedicated schema.
TEST_DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=vitest&connection_limit=5"

# Supabase → Project Settings → API. The service role key is server-only: never expose it to the browser.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="elec-files"

APP_URL="http://localhost:3000"
EMAIL_FROM="Elec <notifications@example.com>"
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
